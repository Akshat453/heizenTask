# Copy to .env.local. Placeholders only; never commit real values.
# NestJS API base URL (no trailing slash). Requests send the HttpOnly session cookie.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Display currency for integer-cent amounts (formatting only; locale en-IN).
NEXT_PUBLIC_CURRENCY=INR
# Show reviewer quick-fill accounts on /login.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
