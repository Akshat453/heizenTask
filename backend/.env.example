# Copy to backend/.env and fill in real values. Never commit real credentials.

# Pooled connection used by the running API (PrismaService).
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Direct (non-pooled) connection used by the Prisma CLI (migrate deploy/status, seed).
DIRECT_URL=postgresql://user:password@host/database?sslmode=require

# Dedicated, disposable database for integration/e2e tests. Must be a different
# database from DATABASE_URL and DIRECT_URL; test startup refuses to run otherwise.
TEST_DATABASE_URL=postgresql://user:password@host/test_database?sslmode=require

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=28800
FRONTEND_URL=http://localhost:3000
AUTH_COOKIE_SAME_SITE=lax
NODE_ENV=development
PORT=3001

# Optional delivery-proof photo storage (private S3 bucket). Leave AWS_S3_BUCKET
# empty to disable photos; note-only delivery keeps working. Credentials come
# from the standard AWS provider chain (env vars, profile, or instance role).
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
